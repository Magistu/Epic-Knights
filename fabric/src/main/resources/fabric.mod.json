{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "license": "${mod_license}",
  "icon": "icon.png",
  "authors": ["Magistu", "SuperSus890", "SteveMe", "itzme1on", "Desperate_bork", "minucius", "hoetistic", "theblackchimera", "Santusio", "Flavius_Blue", "caballerohospitalario", "alhendahu", "Reymecos", "Skydog"],
  "contributors": ["archimedes"],
  "contact": {
    "homepage": "${mod_page_url}",
    "issues": "${mod_issues_url}",
    "sources": "${mod_git_url}",
    "discord": "${mod_discord_url}"
  },
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.magistuarmory.fabric.EpicKnightsFabric"
    ]
  },
  "depends": {
    "fabric": "*",
    "fabricloader": ">=${min_fabric_loader_version}",
    "minecraft": ">=${minecraft_min_version} <${minecraft_max_version}",
    "architectury": ">=${architectury_api_version}",
    "magistuarmory": ">=${epic_knights_version}",
    "forgeconfigapiport": ">=8.0.3"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "${mod_discord_url}"
      }
    }
  }
}